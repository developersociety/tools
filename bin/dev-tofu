#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# help: Run tofu with the devsoc-tofu AWS profile
#
# Usage:
#   dev tofu <tofu arguments>
#
# Use "tofu -help" for tofu's own help, as "--help" is handled here.

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    exec "$(dirname "$0")/dev" help "${0##*/dev-}"
fi

PROFILE="devsoc-tofu"

exec aws-vault exec "$PROFILE" -- tofu "$@"
