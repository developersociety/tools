#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# help: Run tofu with the devsoc-tofu AWS profile
#
# Usage:
#   dev-tofu <tofu arguments>
#
# Use "tofu -help" for tofu's own help, as "--help" is handled here.

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    # Prints the help block above, from its "# help:" line to the first blank line, without
    # the leading "# " or the "help: " marker.
    sed -n -e "/^# help: /,/^$/{s/^# \{0,1\}//; s/^help: //; p;}" "$0"
    exit 0
fi

PROFILE="devsoc-tofu"

exec aws-vault exec "$PROFILE" -- tofu "$@"
