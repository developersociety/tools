#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# help: Uninstall every package in the active virtualenv
#
# Usage:
#   dev-wipeenv
#
# pip, setuptools and wheel are left alone.

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    # Prints the help block above, from its "# help:" line to the first blank line, without
    # the leading "# " or the "help: " marker.
    sed -n -e "/^# help: /,/^$/{s/^# \{0,1\}//; s/^help: //; p;}" "$0"
    exit 0
fi

if [ -z "${VIRTUAL_ENV:-}" ]; then
    echo "Must be in a virtual env"
    exit 1
fi

# Getting packages via "pip list --format=freeze" provides a nicer list than "pip freeze", which
# displays editable packages in a way not supported by "pip uninstall"
#
# Need to make sure not to uninstall pip itself. List of things to avoid comes from docs for
# "pip freeze --all"
if ! pip list --format=freeze | grep -v "^pip=\|^setuptools=\|^wheel=" |
    xargs pip uninstall -y; then
    echo "Nothing to remove"
fi
