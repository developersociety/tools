#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# help: Rewrite ~/.aws/config from the 1Password template
#
# Usage:
#   dev-update-aws-config username
#
# The existing config is moved aside with a timestamped name before the new one is written.

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    # Prints the help block above, from its "# help:" line to the first blank line, without
    # the leading "# " or the "help: " marker.
    sed -n -e "/^# help: /,/^$/{s/^# \{0,1\}//; s/^help: //; p;}" "$0"
    exit 0
fi

CONFIG_FILE="$HOME/.aws/config"

if [ "$#" -ne 1 ]; then
    echo "Usage: dev-update-aws-config username"
    exit 1
fi

CONFIG_USERNAME="$1"

mkdir -p "$HOME/.aws"

if [ -f "$CONFIG_FILE" ]; then
    TIMESTAMP=$(date -u +"%Y%m%dT%H%M%SZ")
    echo "Backup of existing config saved to: $CONFIG_FILE.old.$TIMESTAMP"
    mv "$CONFIG_FILE" "$CONFIG_FILE.old.$TIMESTAMP"
fi

op read "op://Shared/AWS Config Template/notesPlain" |
    sed -e "s|USERNAME|$CONFIG_USERNAME|g" >"$CONFIG_FILE"

echo "Config file updated!"
