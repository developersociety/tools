#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# help: Mirror a repo to the archive server, then archive it on GitHub
#
# Usage:
#   dev archive-repo [org/]repo
#
# Mirrors every branch and tag to the archive server, then archives the repo on GitHub, which
# makes it read-only. A repo name given without an org is assumed to be under developersociety.

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    exec "$(dirname "$0")/dev" help "${0##*/dev-}"
fi

DEFAULT_ORG="developersociety"
ARCHIVE_HOST="smirkenorff.devsoc.org"

if [ "$#" -ne 1 ]; then
    echo "Usage: dev archive-repo [org/]repo"
    exit 1
fi

# Handle org/repo, and repo
REPO_ARG="$1"
case "$REPO_ARG" in
*/*) REPO_NAME="$REPO_ARG" ;;
*) REPO_NAME="$DEFAULT_ORG/$REPO_ARG" ;;
esac
PROJECT_NAME="${REPO_NAME##*/}"

echo "I'm going to mirror: $REPO_NAME"
echo "To the archive server: $ARCHIVE_HOST"
echo "And then archive it on GitHub, which makes it read-only."
echo
read -r -p "Press Enter to continue, or <ctrl>-c to bail"

# Not $TMPDIR - that is the standard var mktemp and git read, and clobbering it would move
# everyone else's temporary files in here too.
WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT

CLONE_DIR="$WORK_DIR/$PROJECT_NAME.git"

git clone --bare "git@github.com:$REPO_NAME.git" "$CLONE_DIR"
git -C "$CLONE_DIR" push --mirror "git@$ARCHIVE_HOST:archive/$PROJECT_NAME.git"

gh repo archive "$REPO_NAME" --yes

echo "Done - $REPO_NAME is mirrored and archived."
