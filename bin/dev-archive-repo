#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# help: Mirror a repo to the archive server
#
# Usage:
#   dev-archive-repo repo
#
# Mirrors every branch and tag of a developersociety repo to the archive server.

# Prints the help block above
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    sed -n -e "/^# help: /,/^$/{s/^# \{0,1\}//; s/^help: //; p;}" "$0"
    exit 0
fi

ORG="developersociety"
ARCHIVE_HOST="smirkenorff.devsoc.org"

if [ "$#" -ne 1 ]; then
    echo "Usage: dev-archive-repo repo"
    exit 1
fi

REPO_ARG="$1"

echo "Archiving $REPO_ARG"

WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT

CLONE_DIR="$WORK_DIR/$REPO_ARG.git"

git clone --bare "git@github.com:$ORG/$REPO_ARG.git" "$CLONE_DIR"
git -C "$CLONE_DIR" push --mirror "git@$ARCHIVE_HOST:archive/$REPO_ARG.git"
