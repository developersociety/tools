#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

# help: Mirror a repo to the archive server
#
# Usage:
#   dev archive-repo repo
#
# Mirrors every branch and tag of a developersociety repo to the archive server.

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    exec "$(dirname "$0")/dev" help "${0##*/dev-}"
fi

if [ $# != 1 ]; then
    echo "Must specify repo name to clone"
    exit 1
fi

GIT_REPO=$1

echo "Archiving ${GIT_REPO}"

TMPDIR=$(mktemp -d)

cd "$TMPDIR"
git clone --bare "git@github.com:developersociety/${GIT_REPO}.git"
cd "${GIT_REPO}.git"
git push --mirror "git@smirkenorff.devsoc.org:archive/${GIT_REPO}.git"
rm -rf "$TMPDIR"
