#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# help: Open the AWS console via aws-vault
#
# Usage:
#   dev aws-login [profile]
#
# Defaults to the profile in $AWS_VAULT_PROFILE, or "devsoc".

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    exec "$(dirname "$0")/dev" help "${0##*/dev-}"
fi

DEFAULT_PROFILE="${AWS_VAULT_PROFILE:-devsoc}"

exec aws-vault login -- "${@:-$DEFAULT_PROFILE}"
