#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# help: Open the AWS console via aws-vault
#
# Usage:
#   dev-aws-login <profile>
#
# Arguments are passed straight through to "aws-vault login".

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    # Prints the help block above, from its "# help:" line to the first blank line, without
    # the leading "# " or the "help: " marker.
    sed -n -e "/^# help: /,/^$/{s/^# \{0,1\}//; s/^help: //; p;}" "$0"
    exit 0
fi

exec aws-vault login -- "$@"
