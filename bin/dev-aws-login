#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# help: Open the AWS console via aws-vault
#
# Usage:
#   dev-aws-login <profile>
#
# Arguments are passed straight through to "aws-vault login".

# Prints the help block above
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    sed -n -e "/^# help: /,/^$/{s/^# \{0,1\}//; s/^help: //; p;}" "$0"
    exit 0
fi

exec aws-vault login -- "$@"
